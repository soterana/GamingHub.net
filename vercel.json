{
  "version": 2,
  "routes": [
    {
      "src": "/search/(.*)",
      "dest": "/search.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ],
    {
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Feature-Policy", "value": "interest-cohort=()" }
      ]
    }
  ]
}
}
